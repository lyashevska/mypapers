@article{klimesova2025,
title = {Effects of temporal, geographical and environmental factors on salmon lice (Lepeophtheirus
salmonis) levels of Atlantic salmon (Salmo salar) in Ireland},
journal = {Scientific Reports},
volume = {15},
pages = {34614},
year = {2025},
author = {Klimesova B., Lyashevska O., Ruane N., D’Arcy, J., Talbot A., Rodger H., O’Dwyer K.},
abstract = {The salmon louse (Lepeophtheirus salmonis) poses a major challenge for Atlantic salmon aquaculture in the northern hemisphere. These ectoparasites feed on the blood, tissue, and mucus of their fish host, causing skin damage, increasing susceptibility to secondary infections, and, in severe cases, leading to fish mortality. The economic impact of salmon lice on aquaculture is substantial, primarily due to the costs of treatment and management. Effective management strategies rely on a comprehensive understanding of infection dynamics. To investigate these dynamics, we analysed a 30-year dataset on sea lice abundance from Atlantic salmon farms in Ireland, collected by the Marine Institute through the National Sea Lice Monitoring Programme. Using generalised linear mixed-effects models, we detected temporal fluctuations, with an overall decline in lice abundance over the study period. Seasonal variation was evident, with the lowest abundance in spring and the highest in autumn. Sea lice abundance was influenced by farm exposure, represented by the width of the mouth, length of the bay and amount of dissolved oxygen. By identifying key factors driving infection patterns, this study provides valuable insights for predicting high-risk periods and optimising management strategies. These findings will inform strategies for salmon lice control, contributing to improved fish health and sustainability in aquaculture.}
